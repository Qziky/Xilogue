  "large_change_ratio": 0.04,
  "candidate_capacity": 2,
  "event_capacity": 300,
  "maintenance_seconds": 60.0,
  "ocr_enabled": true,
  "ocr_threads": 2,
  "excluded_apps": [
    "1password.exe",
    "bitwarden.exe",
    "keepass.exe",
    "keepassxc.exe",
    "passwordmanager.exe"

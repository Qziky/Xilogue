{
  "version": 1,
  "sample_interval_seconds": 5.0,
  "foreground_stabilize_seconds": 0.6,
  "poll_interval_seconds": 0.25,
  "idle_policy": "pause",
  "idle_seconds": 90.0,
  "image_quota_mib": 512,
